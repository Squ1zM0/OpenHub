# ── Daemon ────────────────────────────────────────────────────────────────
OPENHUB_DAEMON_TOKEN=dev-token

# ── GitHub App ────────────────────────────────────────────────────────────
GITHUB_APP_ID= 
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# ── DeepSeek adapter ──────────────────────────────────────────────────────
# Browserless.io token. The connect flow opens a live-view browser the user
# logs into; cookies and selectors are captured and encrypted automatically.
# No manual cookie export. Sign up at https://browserless.io.
BROWSERLESS_TOKEN=

# Browserless region endpoint.
BROWSERLESS_URL=https://production-sfo.browserless.io

# 32-byte key for encrypting stored DeepSeek cookies at rest.
# Generate with:
#     openssl rand -hex 32
DEEPSEEK_CREDENTIAL_KEY=
