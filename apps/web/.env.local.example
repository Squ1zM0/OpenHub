# ── Daemon ────────────────────────────────────────────────────────────────
# Shared secret between the dashboard and the local daemon.
# Used as both the bearer token and the HMAC signing key in v1.
# In production these should be separate; noted in README.
OPENHUB_DAEMON_TOKEN=dev-token

# ── GitHub App ────────────────────────────────────────────────────────────
# Create the App at https://github.com/settings/apps
# App ID is shown at the top of the App's settings page.
GITHUB_APP_ID=

# The App's private key, PKCS#8 PEM format, with newlines preserved.
# Single-line form for .env files — replace actual newlines with \n.
# Example: GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GITHUB_APP_PRIVATE_KEY=

# OAuth credentials (optional — only needed for user-to-server flows)
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# Webhook secret — set the same value in the App's webhook settings.
GITHUB_WEBHOOK_SECRET=
