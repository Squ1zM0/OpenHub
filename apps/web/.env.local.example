# ── Daemon ────────────────────────────────────────────────────────────────
OPENHUB_DAEMON_TOKEN=dev-token

# ── GitHub App ────────────────────────────────────────────────────────────
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# ── DeepSeek adapter ──────────────────────────────────────────────────────
# Browserless.io token. Sign up at https://browserless.io — the free tier
# is enough for development.
BROWSERLESS_TOKEN=

# Browserless region endpoint. Default is US West.
BROWSERLESS_URL=https://production-sfo.browserless.io

# Cookies from a logged-in chat.deepseek.com session, as a JSON array.
#
# How to get these:
#   1. Log in to chat.deepseek.com in your browser.
#   2. Open DevTools → Application → Cookies → https://chat.deepseek.com
#   3. Or use the "EditThisCookie" / "Cookie-Editor" extension and export
#      as JSON.
#   4. Paste the JSON array here, single line, escaped quotes.
#
# Example shape (not real cookies):
# DEEPSEEK_COOKIES='[{"name":"ds_session","value":"abc123","domain":".deepseek.com","path":"/","httpOnly":true,"secure":true,"sameSite":"Lax"}]'
DEEPSEEK_COOKIES=
